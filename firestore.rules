rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUsuario() {
      return signedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // "usuarios/{uid}" é o ponteiro auth -> perfil e a fonte confiável de role.
    function meuUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function minhaRole() {
      return hasUsuario() ? meuUsuario().role : null;
    }

    function isAdmin() {
      return minhaRole() == "administrador";
    }

    function isComite() {
      return minhaRole() == "comite";
    }

    function isStaff() {
      return isAdmin() || isComite();
    }

    function meuAtletaId() {
      return meuUsuario().atletaId;
    }

    function minhaModalidade() {
      let equipe = get(/databases/$(database)/documents/atletas/$(meuAtletaId())).data.equipe;
      return equipe == "corrida" || equipe == "fila_corrida"
        ? "corrida"
        : equipe == "bicicleta" || equipe == "fila_bicicleta"
          ? "bicicleta"
          : null;
    }

    function rankingCorridaLiberado() {
      let path = /databases/$(database)/documents/configuracoes/ranking_visibilidade;
      return !exists(path) ||
        !get(path).data.corrida.ativo ||
        request.time < get(path).data.corrida.inicioEm ||
        request.time > get(path).data.corrida.fimEm;
    }

    function rankingBicicletaLiberado() {
      let path = /databases/$(database)/documents/configuracoes/ranking_visibilidade;
      return !exists(path) ||
        !get(path).data.bicicleta.ativo ||
        request.time < get(path).data.bicicleta.inicioEm ||
        request.time > get(path).data.bicicleta.fimEm;
    }

    function rankingPortalAtletasAtivo() {
      let path = /databases/$(database)/documents/configuracoes/ranking_visibilidade;
      return !exists(path) || get(path).data.get("exibirParaAtletas", true);
    }

    function rankingLiberado(equipe) {
      return rankingPortalAtletasAtivo() && (equipe == "corrida"
        ? rankingCorridaLiberado()
        : equipe == "bicicleta" && rankingBicicletaLiberado());
    }

    function minhasPermissoes() {
      return meuUsuario().get("permissoes", ["inicio"]);
    }

    function comitePode(chave) {
      return isComite() && chave in minhasPermissoes();
    }

    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow write: if isAdmin();
    }

    match /solicitacoes_acesso/{uid} {
      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly([
          "uid", "nome", "email", "status", "criadoEm"
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == "pendente";
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Cadastro completo: somente equipe de gestão ou o próprio atleta.
    // Antes da primeira sincronização pública, mantém compatibilidade temporária
    // para que a migração possa ser feita sem interromper o ranking.
    match /atletas/{atletaId} {
      allow read: if isStaff() ||
        (hasUsuario() && meuAtletaId() == atletaId) ||
        (hasUsuario() &&
          !exists(/databases/$(database)/documents/configuracoes/privacidade_atletas));
      allow create: if isAdmin() || comitePode("atletas");
      allow update: if isAdmin() ||
        (comitePode("atletas") &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "role", "visivelNasListas", "ocultadoEm", "ocultadoPor"
          ])) ||
        (comitePode("registrar") &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pontuacaoTotal", "atualizadoEm"])) ||
        (hasUsuario() && meuAtletaId() == atletaId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["nome", "sexo", "dataNascimento", "localidade", "atualizadoEm"]));
      allow delete: if isAdmin();
    }

    match /atletas_publicos/{atletaId} {
      // Gestão vê as duas modalidades. O atleta só lê documentos da própria
      // modalidade e apenas fora dos períodos de fechamento programados.
      allow read: if isStaff() ||
        (hasUsuario() &&
          resource.data.equipe == minhaModalidade() &&
          rankingLiberado(resource.data.equipe));
      allow create, delete: if isAdmin() || comitePode("atletas") || comitePode("registrar");
      allow update: if isAdmin() || comitePode("atletas") || comitePode("registrar") ||
        (hasUsuario() && meuAtletaId() == atletaId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["nome"]));
    }

    match /ranking_resultados/{id} {
      allow read: if isStaff() ||
        (hasUsuario() &&
          resource.data.equipe == minhaModalidade() &&
          rankingLiberado(resource.data.equipe));
      allow create, update, delete: if isAdmin();
    }

    // Cada atleta lê apenas o próprio histórico. Comitê e administrador
    // continuam com acesso conforme suas responsabilidades.
    match /historico_pontos/{id} {
      allow read: if isStaff() ||
        (hasUsuario() && resource.data.atletaId == meuAtletaId());
      allow create, update: if isAdmin() || comitePode("registrar");
      allow delete: if isAdmin();
    }

    // Contém informações potencialmente sensíveis (doença, lesão e descrição).
    // Todo acesso passa pelas rotas autenticadas do servidor, que limitam a
    // leitura ao próprio atleta ou à equipe autorizada de pontuação.
    match /justificativas_ausencia/{id} {
      allow read, write: if false;
    }

    match /regras_pontuacao/{id} {
      allow read: if hasUsuario();
      allow write: if isAdmin() || comitePode("regras");
    }

    match /agenda_eventos/{id} {
      allow read: if hasUsuario();
      allow create, delete: if isAdmin() || comitePode("eventos");
      allow update: if isAdmin() || comitePode("eventos") ||
        (hasUsuario() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["inscritos"]) &&
          (
            (request.resource.data.inscritos.removeAll([meuAtletaId()]) == resource.data.get("inscritos", []) &&
              request.resource.data.inscritos.hasAll([meuAtletaId()])) ||
            (resource.data.get("inscritos", []).removeAll([meuAtletaId()]) == request.resource.data.inscritos)
          )
        );
    }

    match /noticias/{id} {
      allow read: if hasUsuario();
      allow write: if isAdmin() || comitePode("noticias");
    }

    match /despesas/{id} {
      allow read, write: if isAdmin() || comitePode("financeiro");
    }

    match /empresas_pagadoras/{id} {
      allow read, write: if isAdmin() || comitePode("financeiro");
    }

    match /comentarios_atletas/{id} {
      allow read, write: if isAdmin() || comitePode("atletas") || comitePode("registrar");
    }

    match /auditoria/{id} {
      allow read: if isAdmin() || (comitePode("atletas") && resource.data.entidade == "atletas");
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /configuracoes/branding {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /configuracoes/{docId} {
      allow read: if hasUsuario();
      allow write: if isAdmin();
    }
  }
}

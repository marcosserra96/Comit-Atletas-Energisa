# Copie este arquivo para .env.local (desenvolvimento) ou configure estas
# mesmas variáveis no painel do seu host (Vercel, etc.) para produção.

# Desenvolvimento local: "true" usa o Firebase Emulator Suite, sem projeto real.
# Produção: "false" — preencha as credenciais reais abaixo.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Credenciais do app Web do projeto Firebase (Configurações do projeto > Seus apps).
# Só são necessárias quando NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Credencial administrativa usada apenas no servidor para sincronizar contas
# do Firebase Authentication. Nunca use o prefixo NEXT_PUBLIC_ nestas variáveis.
# Você pode informar o JSON completo da conta de serviço em uma única variável:
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
# Ou informar os três campos separadamente:
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
